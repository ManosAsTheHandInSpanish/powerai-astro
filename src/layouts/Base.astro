---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "./partials/Header.astro";

const gtmEnabled = config.google_tag_manager?.enable;
const gtmId = config.google_tag_manager?.gtm_id;

// font families
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, meta_title, description, image, noindex, canonical } =
  Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Google Tag Manager -->
    {gtmEnabled && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer', gtmId);
      </script>
    )}
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="ohtomation" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonical || `${config.site.base_url}${Astro.url.pathname}`} />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- author -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />

    <!-- Schema JSON-LD Organisation -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Ohtomation",
      "description": "Expert en automatisation et intelligence artificielle à Nantes. Solutions sur mesure pour les TPE et PME.",
      "url": "https://www.ohtomation.fr",
      "logo": "https://www.ohtomation.fr/images/logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Rezé",
        "addressRegion": "Loire-Atlantique",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 47.1784,
        "longitude": -1.5546
      },
      "areaServed": {
        "@type": "Country",
        "name": "France"
      },
      "founder": {
        "@type": "Person",
        "name": "Emmanuel Kouratoras"
      },
      "sameAs": [
        "https://www.linkedin.com/in/kouratoras/"
      ],
      "serviceType": [
        "Automatisation des processus",
        "Intelligence artificielle",
        "Agents IA",
        "Génération de leads",
        "Automatisation e-commerce",
        "NoCode"
      ],
      "priceRange": "€€"
    }
    </script>

    <!-- Schema JSON-LD FAQ -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Par où commencer quand on veut automatiser ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On démarre par un audit de 30 minutes pour identifier vos tâches répétitives les plus chronophages. On priorise ensemble les quick wins — les automatisations simples qui vous font gagner du temps dès la première semaine."
          }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour mettre en place une automatisation ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre 1 et 4 semaines selon la complexité. Un workflow simple (relances email, synchronisation CRM) peut être opérationnel en quelques jours. Un projet complet (onboarding client, gestion e-commerce) prend 2 à 4 semaines."
          }
        },
        {
          "@type": "Question",
          "name": "Est-ce que l'automatisation va remplacer mes employés ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non. L'automatisation supprime les tâches répétitives pour que vos équipes se concentrent sur ce qui a de la valeur — la relation client, la stratégie, la créativité."
          }
        },
        {
          "@type": "Question",
          "name": "Quels outils utilisez-vous ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Principalement n8n, Make, Airtable, Fillout et des API d'intelligence artificielle (OpenAI, Google AI). On s'adapte aussi à vos outils existants — CRM, ERP, Shopify, messagerie."
          }
        },
        {
          "@type": "Question",
          "name": "Combien ça coûte ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nos solutions démarrent à partir de 2 400€ selon le cas d'usage. Chaque devis est sur mesure et adapté à vos besoins réels. L'investissement est généralement rentabilisé en moins de 3 mois."
          }
        },
        {
          "@type": "Question",
          "name": "Est-ce que ça fonctionne pour une petite entreprise ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "C'est justement là que l'impact est le plus fort. Une PME de 5 à 50 personnes qui automatise ses relances, son onboarding ou sa facturation peut récupérer plusieurs jours par mois — sans recruter."
          }
        },
        {
          "@type": "Question",
          "name": "Est-ce que mes données sont en sécurité ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui. Les outils utilisés respectent le RGPD. Vos données ne sont jamais partagées avec des tiers. Les automatisations tournent sur des serveurs sécurisés et les accès sont strictement contrôlés."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre Ohtomation et une agence web classique ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une agence web construit des sites. Ohtomation connecte vos outils entre eux et automatise vos processus métier — prospection, onboarding, facturation, gestion de stock."
          }
        }
      ]
    }
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {gtmEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <TwSizeIndicator />
    <Header  />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer  />
  </body>
</html>
