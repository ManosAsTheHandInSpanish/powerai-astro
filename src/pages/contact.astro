---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import FAQ from "@/partials/FAQ";
import PageHeader from "@/partials/PageHeader.astro";
import { getListPage } from "@/lib/contentParser";

const data = await getListPage("contact/-index.md");
const { title, description, meta_title, image, page_header } = data.frontmatter;
const faq = await getListPage("sections/faq.md");
const callToAction = await getListPage("sections/call-to-action.md");
---

<Base title={title} meta_title={meta_title} description={description} image={image}>
  <PageHeader page_header={page_header} />
  <div class="container pb-20">
    <div style="width:100%;height:500px;" data-fillout-id="piPStxvEPwus" data-fillout-embed-type="standard" data-fillout-inherit-parameters data-fillout-dynamic-resize></div>
    <script is:inline src="https://server.fillout.com/embed/v1/"></script>
  </div>
  <FAQ data={faq} client:visible />
</Base>
